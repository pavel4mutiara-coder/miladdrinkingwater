{
  "entities": {
    "Vehicle": {
      "title": "Vehicle",
      "description": "Information about a company vehicle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vehicleNumber": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["vehicleNumber", "createdAt"]
    },
    "Maintenance": {
      "title": "Maintenance",
      "description": "Repair and parts replacement log for a vehicle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vehicleId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "partsReplaced": { "type": "string" },
        "description": { "type": "string" },
        "cost": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["vehicleId", "date", "description", "createdAt"]
    },
    "VehicleIncome": {
      "title": "Vehicle Daily Income",
      "description": "Daily income generated by a vehicle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vehicleId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "amount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["vehicleId", "date", "amount", "createdAt"]
    },
    "Dealer": {
      "title": "Dealer",
      "description": "Information about a water dealer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "createdAt"]
    },
    "WaterSale": {
      "title": "Water Sale",
      "description": "Record of water jars/bottles sold to a dealer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dealerId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "productType": { "type": "string", "enum": ["20L Jar", "5L Bottle", "Other"] },
        "quantity": { "type": "number" },
        "rate": { "type": "number" },
        "totalAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["dealerId", "date", "productType", "quantity", "rate", "totalAmount", "createdAt"]
    },
    "CompanyExpense": {
      "title": "Company Expense",
      "description": "General expenses for the company",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "category", "amount", "createdAt"]
    }
  },
  "firestore": {
    "vehicles": {
      "schema": "Vehicle",
      "description": "Collection of company vehicles"
    },
    "maintenance": {
      "schema": "Maintenance",
      "description": "Vehicle repair and maintenance logs"
    },
    "vehicle_income": {
      "schema": "VehicleIncome",
      "description": "Daily income logs for vehicles"
    },
    "dealers": {
      "schema": "Dealer",
      "description": "Collection of water dealers"
    },
    "water_sales": {
      "schema": "WaterSale",
      "description": "Water sale transactions per dealer"
    },
    "company_expenses": {
      "schema": "CompanyExpense",
      "description": "General business expenses"
    }
  }
}
