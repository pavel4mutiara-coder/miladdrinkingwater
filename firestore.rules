rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn();
    }

    function isValidId(id) {
       return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidVehicle(data) {
      return data.keys().hasAll(['vehicleNumber', 'name', 'type']) &&
             data.vehicleNumber is string && data.vehicleNumber.size() > 0 &&
             data.name is string &&
             data.type is string &&
             (data.registrationNumber == null || data.registrationNumber is string) &&
             (data.imageURL == null || data.imageURL is string) &&
             (data.fitnessDate == null || data.fitnessDate is string) &&
             (data.insuranceDate == null || data.insuranceDate is string) &&
             (data.taxTokenDate == null || data.taxTokenDate is string) &&
             (data.createdAt == null || data.createdAt is timestamp || data.createdAt == request.time);
    }

    function isValidMaintenance(data) {
      return data.keys().hasAll(['vehicleId', 'date', 'description']) &&
             data.vehicleId is string &&
             data.date is string &&
             data.description is string &&
             (data.mechanicName == null || data.mechanicName is string) &&
             (data.sparePartsCost == null || data.sparePartsCost is number) &&
             (data.nextServiceDate == null || data.nextServiceDate is string) &&
             (data.createdAt == null || data.createdAt is timestamp || data.createdAt == request.time);
    }

    function isValidVehicleIncome(data) {
      return data.keys().hasAll(['vehicleId', 'date', 'amount']) &&
             data.vehicleId is string &&
             data.date is string &&
             data.amount is number &&
             (data.driverName == null || data.driverName is string) &&
             (data.routeDetails == null || data.routeDetails is string) &&
             (data.createdAt == null || data.createdAt is timestamp || data.createdAt == request.time);
    }

    function isValidDealer(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() > 0 &&
             (data.address == null || data.address is string) &&
             (data.phone == null || data.phone is string) &&
             (data.createdAt == null || data.createdAt is timestamp || data.createdAt == request.time);
    }

    function isValidWaterSale(data) {
      return data.dealerId is string &&
             data.date is string &&
             data.productType is string &&
             data.quantity is number &&
             data.unitPrice is number &&
             data.totalAmount is number &&
             (data.createdAt == null || data.createdAt is timestamp || data.createdAt == request.time) &&
             (data.updatedAt == null || data.updatedAt is timestamp || data.updatedAt == request.time);
    }

    function isValidCompanyExpense(data) {
      return data.keys().hasAll(['date', 'category', 'amount']) &&
             data.date is string &&
             data.category is string &&
             data.amount is number &&
             (data.dealerId == null || data.dealerId is string) &&
             (data.createdAt == null || data.createdAt is timestamp || data.createdAt == request.time);
    }

    function isValidExpenseCategory(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string &&
             (data.createdAt == null || data.createdAt is timestamp || data.createdAt == request.time);
    }

    function isValidDriver(data) {
      return data.keys().hasAll(['name', 'phone', 'nid']) &&
             data.name is string &&
             data.phone is string &&
             data.nid is string &&
             (data.createdAt == null || data.createdAt is timestamp || data.createdAt == request.time);
    }

    function isValidCNG(data) {
      return data.keys().hasAll(['cngNumber', 'driverId', 'dailyPayment']) &&
             data.cngNumber is string &&
             data.driverId is string &&
             data.dailyPayment is number &&
             (data.createdAt == null || data.createdAt is timestamp || data.createdAt == request.time);
    }

    function isValidCNGIncome(data) {
      return data.keys().hasAll(['cngId', 'date', 'amount']) &&
             data.cngId is string &&
             data.date is string &&
             data.amount is number &&
             (data.createdAt == null || data.createdAt is timestamp || data.createdAt == request.time);
    }

    function isValidCNGExpense(data) {
      return data.keys().hasAll(['cngId', 'date', 'type', 'amount']) &&
             data.cngId is string &&
             data.date is string &&
             data.type is string &&
             data.amount is number &&
             (data.createdAt == null || data.createdAt is timestamp || data.createdAt == request.time);
    }

    // --- Rules ---

    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidDriver(incoming());
      allow update: if isAdmin() && isValidDriver(incoming());
      allow delete: if isAdmin();
    }

    match /cng_rickshaws/{cngId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidCNG(incoming());
      allow update: if isAdmin() && isValidCNG(incoming());
      allow delete: if isAdmin();
    }

    match /cng_income/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidCNGIncome(incoming());
      allow update: if isAdmin() && isValidCNGIncome(incoming());
      allow delete: if isAdmin();
    }

    match /cng_expenses/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidCNGExpense(incoming());
      allow update: if isAdmin() && isValidCNGExpense(incoming());
      allow delete: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidVehicle(incoming());
      allow update: if isAdmin() && isValidVehicle(incoming());
      allow delete: if isAdmin();
    }

    match /maintenance/{mainId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidMaintenance(incoming());
      allow update: if isAdmin() && isValidMaintenance(incoming());
      allow delete: if isAdmin();
    }

    match /vehicle_income/{incomeId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidVehicleIncome(incoming());
      allow update: if isAdmin() && isValidVehicleIncome(incoming());
      allow delete: if isAdmin();
    }

    match /dealers/{dealerId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidDealer(incoming());
      allow update: if isAdmin() && isValidDealer(incoming());
      allow delete: if isAdmin();
    }

    match /water_sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidWaterSale(incoming());
      allow update: if isAdmin() && isValidWaterSale(incoming());
      allow delete: if isAdmin();
    }

    match /company_expenses/{expId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidCompanyExpense(incoming());
      allow update: if isAdmin() && isValidCompanyExpense(incoming());
      allow delete: if isAdmin();
    }

    match /expense_categories/{catId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidExpenseCategory(incoming());
      allow update: if isAdmin() && isValidExpenseCategory(incoming());
      allow delete: if isAdmin();
    }
  }
}
